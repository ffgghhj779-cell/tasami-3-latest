// Tasami – Prisma Schema
// PostgreSQL · Absolute simplicity · CRM + Services backbone

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Language {
  AR
  EN
  UR
  HI
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  VIP
  ARCHIVED
}

enum CustomerSegment {
  INDIVIDUAL
  SME
  ENTERPRISE
  GOVERNMENT
}

enum Channel {
  WHATSAPP
  WEB_CHAT
  PHONE
  EMAIL
  IN_PERSON
}

enum Sender {
  CUSTOMER
  BOT
  AGENT
  SYSTEM
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
}

enum ServiceCategory {
  GOVERNMENT
  TECH
  SECTOR
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum CampaignType {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum ReminderType {
  FOLLOW_UP
  PAYMENT
  DOCUMENT
  APPOINTMENT
  RENEWAL
  CUSTOM
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Customer {
  id               String          @id @default(cuid())
  name             String
  phone            String          @unique
  email            String?
  language         Language        @default(AR)
  dialect          String?
  segment          CustomerSegment @default(INDIVIDUAL)
  sector           String?
  cr_number        String?
  status           CustomerStatus  @default(LEAD)
  notes            String?
  last_interaction DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conversations Conversation[]
  tasks         Task[]
  reminders     Reminder[]

  @@index([status])
  @@index([segment])
  @@index([sector])
  @@index([last_interaction])
  @@map("customers")
}

model Conversation {
  id          String     @id @default(cuid())
  customer_id String
  channel     Channel    @default(WHATSAPP)
  message     String
  sender      Sender
  sentiment   Sentiment?
  intent      String?

  created_at DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([channel])
  @@index([created_at])
  @@index([intent])
  @@map("conversations")
}

model Service {
  id          String          @id @default(cuid())
  name_ar     String
  name_en     String
  category    ServiceCategory
  subcategory String?
  price_from  Decimal?        @db.Decimal(12, 2)
  price_to    Decimal?        @db.Decimal(12, 2)
  duration    String?
  description String?
  slug        String          @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tasks Task[]

  @@index([category])
  @@index([subcategory])
  @@map("services")
}

model Task {
  id          String     @id @default(cuid())
  customer_id String
  service_id  String?
  status      TaskStatus @default(PENDING)
  assigned_to String?
  due_date    DateTime?
  notes       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [service_id], references: [id], onDelete: SetNull)

  @@index([customer_id])
  @@index([service_id])
  @@index([status])
  @@index([assigned_to])
  @@index([due_date])
  @@map("tasks")
}

model Campaign {
  id               String         @id @default(cuid())
  name             String
  type             CampaignType
  target_segment   String?
  message_template String
  scheduled_at     DateTime?
  status           CampaignStatus @default(DRAFT)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([scheduled_at])
  @@map("campaigns")
}

model Reminder {
  id            String       @id @default(cuid())
  customer_id   String
  type          ReminderType @default(FOLLOW_UP)
  reminder_date DateTime
  sent          Boolean      @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([reminder_date])
  @@index([sent])
  @@map("reminders")
}
