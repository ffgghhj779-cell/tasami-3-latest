// Khalsana – Prisma Schema (aligned to master brief tables)
// PostgreSQL · Absolute simplicity · CRM + Services backbone

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (brief-aligned + backwards-compatible values)
// ---------------------------------------------------------------------------

enum Language {
  AR
  EN
  UR
  HI
}

enum CustomerStatus {
  LEAD
  ACTIVE
  SLEEPING
  ANGRY
  INACTIVE
  VIP
  ARCHIVED
}

enum CustomerSegment {
  INDIVIDUAL
  COMPANY
  FAMILY
  STARTUP
  NONPROFIT
  INVESTOR
  SME
  ENTERPRISE
  GOVERNMENT
}

enum Channel {
  WHATSAPP
  TELEGRAM
  EMAIL
  SITE
  WEB_CHAT
  PHONE
  IN_PERSON
}

enum Sender {
  CUSTOMER
  BOT
  SECRETARY
  AGENT
  SYSTEM
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  ANGRY
  MIXED
}

enum ServiceCategory {
  GOVERNMENT
  TECH
  SECTOR
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  WAITING
  COMPLETED
  DONE
  CANCELLED
}

enum CampaignType {
  WELCOME
  REMINDER
  OFFER
  NATIONAL_DAY
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum ReminderType {
  IQAMA_EXPIRY
  CR_EXPIRY
  FOLLOW_UP
  PAYMENT
  DOCUMENT
  APPOINTMENT
  RENEWAL
  CUSTOM
}

enum UserRole {
  CLIENT
  ADMIN
}

// ---------------------------------------------------------------------------
// Models — customers, conversations, services, tasks,
// campaigns, reminders, users (site auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?  @unique
  password_hash String
  role          UserRole @default(CLIENT)
  customer_id   String?  @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer     Customer?            @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  reset_tokens PasswordResetToken[]

  @@index([role])
  @@map("users")
}

model Customer {
  id               String          @id @default(cuid())
  name             String
  phone            String          @unique
  email            String?
  language         Language        @default(AR)
  dialect          String?
  segment          CustomerSegment @default(INDIVIDUAL)
  sector           String?
  cr_number        String?
  status           CustomerStatus  @default(ACTIVE)
  notes            String?
  last_interaction DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conversations Conversation[]
  tasks         Task[]
  reminders     Reminder[]
  user          User?

  @@index([status])
  @@index([segment])
  @@index([sector])
  @@index([last_interaction])
  @@map("customers")
}

model Conversation {
  id          String     @id @default(cuid())
  customer_id String
  channel     Channel    @default(WHATSAPP)
  message     String
  sender      Sender
  sentiment   Sentiment?
  intent      String?

  created_at DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([channel])
  @@index([created_at])
  @@index([intent])
  @@index([sentiment])
  @@map("conversations")
}

model Service {
  id          String          @id @default(cuid())
  name_ar     String
  name_en     String
  category    ServiceCategory
  subcategory String?
  price_from  Decimal?        @db.Decimal(12, 2)
  price_to    Decimal?        @db.Decimal(12, 2)
  duration    String?
  description String?
  slug        String          @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tasks Task[]

  @@index([category])
  @@index([subcategory])
  @@map("services")
}

model Task {
  id          String     @id @default(cuid())
  customer_id String
  service_id  String?
  status      TaskStatus @default(PENDING)
  assigned_to String?
  due_date    DateTime?
  notes       String?
  /// Uploaded docs: [{ name, mime, size, dataBase64 }]
  attachments Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [service_id], references: [id], onDelete: SetNull)

  @@index([customer_id])
  @@index([service_id])
  @@index([status])
  @@index([assigned_to])
  @@index([due_date])
  @@map("tasks")
}

model RateLimit {
  id       String   @id @default(cuid())
  key      String   @unique
  count    Int      @default(0)
  reset_at DateTime

  @@index([reset_at])
  @@map("rate_limits")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  used       Boolean  @default(false)

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model Campaign {
  id               String         @id @default(cuid())
  name             String
  type             CampaignType
  target_segment   String?
  message_template String
  scheduled_at     DateTime?
  status           CampaignStatus @default(SCHEDULED)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([scheduled_at])
  @@map("campaigns")
}

model Reminder {
  id            String       @id @default(cuid())
  customer_id   String
  type          ReminderType @default(FOLLOW_UP)
  reminder_date DateTime
  sent          Boolean      @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([reminder_date])
  @@index([sent])
  @@map("reminders")
}
