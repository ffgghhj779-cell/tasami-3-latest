# PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tasami?schema=public"

# Public site URL (SEO / OpenGraph / sitemap / canonical)
NEXT_PUBLIC_SITE_URL="https://www.tasamiservices.com"

# JWT session signing — REQUIRED in production (min 32 chars)
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional: phone that auto-promotes to ADMIN on register/login
ADMIN_PHONE="05xxxxxxxx"

# n8n / Hermes AI webhook for Monjez chat (server-side only preferred)
HERMES_WEBHOOK_URL=""

# WhatsApp number (digits only, country code, no +)
# Official WhatsApp: +966 55 996 2847
NEXT_PUBLIC_WHATSAPP_NUMBER="966559962847"

# Main public phone for calls (digits only, country code, no +)
# Displayed next to WhatsApp: 054 228 9575
NEXT_PUBLIC_PHONE_NUMBER="966542289575"

# Public contact email shown in footer / legal pages
NEXT_PUBLIC_CONTACT_EMAIL="hello@tasamiservices.com"

# Company legal details shown in footer / legal pages
NEXT_PUBLIC_COMPANY_CR="0000000000"
NEXT_PUBLIC_COMPANY_VAT="000000000000003"
NEXT_PUBLIC_COMPANY_ADDRESS="Riyadh, Kingdom of Saudi Arabia"

# Resend (transactional email) — optional
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Tasami <hello@tasamiservices.com>"

# Google Analytics measurement ID — optional (G-XXXXXXXX)
NEXT_PUBLIC_GA_ID=""

# Search Console / Bing verification tokens — optional
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# n8n / ops webhook for new request + status change notifications — optional
NOTIFY_WEBHOOK_URL=""

# Admin inbox for new-request email notifications — optional (falls back to NEXT_PUBLIC_CONTACT_EMAIL)
ADMIN_NOTIFY_EMAIL=""
